PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=consultant_utilization_dashboard

# Password reset email (Resend)
RESEND_API_KEY=
AUTH_EMAIL_FROM=NEXCORE <no-reply@example.com>
APP_URL=http://localhost:3000
# Local development only: print reset OTPs in the backend terminal instead of sending email.
PASSWORD_RESET_CONSOLE_OTP=true

# Standalone Session & JWT Security
# Generate a cryptographically random secret string in production (at least 32 characters)
SESSION_SECRET=your-random-32-character-session-secret-here
APP_ID=nexor-app

# Cookie & CSRF Security Policies
# "lax" (recommended default for direct web SaaS), "strict", or "none" (required only for cross-site iframe embedding, mandates secure=true)
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# Optional Legacy OAuth Compatibility (only required if integrating with external Manus OAuth provider)
# MANUS_PROJECT_ID=
# MANUS_JWT_SECRET=
# MANUS_OAUTH_API_URL=
