# NEXOR — Backend Production Environment Configuration
# Node Environment
NODE_ENV=production
PORT=5000

# MongoDB Database Connection
# IMPORTANT: In production, a MongoDB Atlas or replica set URI (mongodb+srv://) is required
# for multi-document transaction atomicity between time entry transitions and approval history records.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=nexcore_production

# Replica Set Transaction Policy
# Set to true to strictly prevent non-transactional fallback approvals in production
REQUIRE_REPLICA_SET_TRANSACTIONS=true
# Only set to true if running a single-node MongoDB deployment that acknowledges lack of distributed transactions
ALLOW_STANDALONE_IN_PROD=false

# Authentication & Session Security
# Generate a cryptographically secure random secret (e.g., openssl rand -hex 32)
MANUS_JWT_SECRET=replace_with_a_secure_64_character_random_hex_string

# Session Cookie Configuration
# "lax" is recommended for direct domain/subdomain web applications (robust CSRF defense)
# "none" is only required if the app is embedded in cross-site preview iframes (forces secure=true)
# "strict" is for maximum isolation
COOKIE_SAME_SITE=lax
COOKIE_SECURE=true

# CORS Whitelist (comma-separated allowed origins)
# Example: https://app.nexcore.com,https://admin.nexcore.com
CORS_ALLOWED_ORIGINS=https://app.nexcore.com
FRONTEND_URL=https://app.nexcore.com

# Platform OAuth / SSO Configuration (optional if using external SSO provider)
MANUS_PROJECT_ID=
MANUS_OAUTH_API_URL=
OWNER_OPEN_ID=
