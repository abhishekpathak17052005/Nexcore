# Backend runtime settings. backend/.env.example contains the same template.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=consultant_utilization_dashboard

# Password reset/change email (Resend SMTP)
RESEND_API_KEY=
AUTH_EMAIL_FROM=NEXCORE <no-reply@example.com>
APP_URL=http://localhost:3000
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
SMTP_SECURE=true
PASSWORD_RESET_CONSOLE_OTP=true

# Standalone Session & JWT Security
SESSION_SECRET=your-random-32-character-session-secret-here
APP_ID=nexor-app

# Cookie & CSRF Security Policies
# "lax" is recommended for direct web SaaS; "none" requires secure cookies.
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# Optional Legacy OAuth Compatibility
# MANUS_PROJECT_ID=
# MANUS_JWT_SECRET=
# MANUS_OAUTH_API_URL=
