# Server-only MongoDB connection. Never commit a real value.
MONGODB_URI=mongodb://user:password@127.0.0.1:27017
MONGODB_DB_NAME=consultant_utilization_dashboard

# Standalone Session & JWT Security
SESSION_SECRET=your-random-32-character-session-secret-here
APP_ID=nexor-app

# Cookie Policies: "lax" (recommended default), "strict", or "none" (mandates secure=true)
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# Optional Legacy OAuth Compatibility
# MANUS_PROJECT_ID=
# MANUS_JWT_SECRET=
# MANUS_OAUTH_API_URL=
